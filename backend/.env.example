# OpenAI 兼容接口（也可用于国内兼容网关）
OPENAI_API_KEY=sk-4c5f4a3f54344065b264eaa75bb33807
OPENAI_BASE_URL=https://api.deepseek.com
# DeepSeek thinking + LangGraph 工具循环时，API 要求每轮把 reasoning_content 原样带回；通用 ChatOpenAI 易触发 400。
# 默认 false：对 deepseek.com 网关自动附加 extra_body 关闭 thinking。若使用完整支持该协议的客户端可改为 true。
# DEEPSEEK_THINKING_ENABLED=false
# 主调度 / Worker 模型名（兼容 OpenAI API 即可）
SCHEDULER_MODEL=deepseek-v4-pro
WORKER_MODEL=deepseek-v4-pro

# 数据根目录（其下按 user_id 分子目录）。留空或未设置时默认为 backend/data。
# 若写相对路径（如 ./data），会解析为相对于 backend 项目根，而不是当前 shell 的 cwd。
# DATA_DIR=./data

# 向量 RAG（BGE-M3 + Chroma）：需 FlagEmbedding；新版 transformers 在 torch<2.6 加载部分权重时会报错，
# 可升级 PyTorch 至 2.6+，或接受仅 BM25（无向量）入库。

# 单次 WS 请求内主图结束后自动续跑上限（吸收非阻塞队列）
MAX_SCHEDULER_AUTO_ROUNDS=12

# 图内 agent↔tool 反思步数上限（LangGraph recursion_limit），与 MAX_SCHEDULER_AUTO_ROUNDS 不同
SCHEDULER_RECURSION_LIMIT=40
WORKER_RECURSION_LIMIT=40

# MCP：传给 MultiServerMCPClient 的 JSON（单行）；留空则不加载 MCP
# MCP_SERVERS_JSON={"math":{"command":"python","args":["/abs/path/math_server.py"],"transport":"stdio"}}
# 主调度 / Worker 各自允许暴露的 MCP 工具名（逗号分隔）；空=不暴露；* = 全部
# SCHEDULER_MCP_TOOL_NAMES=
# WORKER_MCP_TOOL_NAMES=

# 无 WS 连接时后台消化通知队列（轮询间隔秒）
IDLE_QUEUE_PROCESSOR_ENABLED=true
IDLE_QUEUE_POLL_INTERVAL=2.0

# 短期记忆窗口（仅影响每次喂给模型的上下文，不影响 md 全量历史存储）
SHORT_TERM_MAX_MESSAGES=80
# 长期记忆每个字段最多保留条目数
LONG_TERM_LIST_MAX_ITEMS=20

# 用户级长期记忆结构化抽取用小模型（可与 SCHEDULER_MODEL 不同）
MEMORY_EXTRACT_MODEL=deepseek-v4-pro
#学习主题记忆要点条数上限
LEARNING_CONTENT_MAX_KEY_POINTS=24
#新开对话匹配已有学习主题的最低相似度（调高则更保守）
LEARNING_MATCH_MIN_SCORE=0.12
#无 LLM 时写入学习档案的分词重叠下限（防跑题污染）
LEARNING_UPDATE_HEURISTIC_MIN_OVERLAP=0.10

# RAG：先按章节（Markdown 标题/第X章/节/Chapter）切块，章内再按 tiktoken 滑动窗口
RAG_CHUNK_ENCODING=cl100k_base
RAG_CHUNK_MAX_TOKENS=512
RAG_CHUNK_OVERLAP_TOKENS=64
RAG_SPLIT_ON_SECTION_LINES=true

# RAG 上传：单文件上限（MB，1–256）；扫描版 PDF 需系统安装 Tesseract 及语言包（如 chi_sim）
# RAG_UPLOAD_MAX_MB=32
# RAG_PDF_OCR_FALLBACK=true
# RAG_PDF_OCR_MAX_PAGES=40
# RAG_PDF_OCR_LANG=chi_sim+eng
# RAG_PDF_OCR_ZOOM=2.0

# Web 前端登录：JWT 密钥（生产务必修改）；账号 JSON，键为登录名、值为明文密码（生产请配合 HTTPS）
JWT_SECRET=change-me-in-production
JWT_EXPIRE_HOURS=168
AUTH_USERS_JSON={"demo":"demo"}
